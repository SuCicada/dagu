# Git
.git/
.github/
.gitignore

# Node/UI
ui/node_modules/
ui/dist/
node_modules/
*.log
npm-debug.log*

# Go
bin/
*.test
*.out
coverage.txt
coverage.html

# Build artifacts
internal/service/frontend/assets/
internal/service/frontend/docs/
dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Documentation
# The VitePress site under docs/origin IS needed - it is built into the binary
# and served at /docs - so its sources must stay in the build context.
*.md
!README.md
!docs/origin/**/*.md

# Docs build artifacts / deps (never send these to the daemon)
docs/origin/node_modules
docs/origin/node_modules/**
docs/origin/.vitepress/dist
docs/origin/.vitepress/dist/**
docs/origin/.vitepress/cache
docs/origin/.vitepress/cache/**

# Test data
tmp/
.tmp/
testdata/

# CI/CD

# Development files
docker-compose*.yml
deploy/

# Kubernetes
*.yaml
!ui/*.yaml
!docs/origin/**/*.yaml
/data
.local
.agents/

*.exe
assets/images/

